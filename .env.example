# Generate a token with: openssl rand -hex 32
# Required: at least 32 characters, no whitespace. Never commit the real token.
MCP_TOKEN=

# Optional settings (defaults shown).
# MCP_PORT=8765
# MCP_ALLOWED_ORIGINS=
# OUTLOOK_URL=https://outlook.office.com/mail/
# OUTLOOK_IDLE_MINUTES=20
# OUTLOOK_NOTIFY=1
